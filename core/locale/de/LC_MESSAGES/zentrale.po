# ZENTRALE core — German UI texts (gettext). msgid = English (CLAUDE.md "Language").
# After editing: msgfmt -o zentrale.mo zentrale.po (tests/test_i18n.py checks they match).
msgid ""
msgstr ""
"Project-Id-Version: zentrale\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: de\n"

msgid "the event does not exist"
msgstr "den Termin gibt es nicht"

msgid "deleting needs basis_sha (which version was seen)"
msgstr "Löschen braucht basis_sha (welche Fassung gesehen wurde)"

msgid "changed in the cloud meanwhile — not deleted"
msgstr "inzwischen in der Mitte geändert — nicht gelöscht"

msgid "not a readable event"
msgstr "kein lesbarer Termin"

msgid "one file holds exactly one event (one UID)"
msgstr "eine Datei hält genau einen Termin (eine UID)"

msgid "the main part of the event is missing (deleting only with loeschen)"
msgstr "der Hauptteil des Termins fehlt (Löschen nur mit loeschen)"

msgid "another event lives under this name"
msgstr "unter diesem Namen liegt ein anderer Termin"

msgid "deleted in the cloud, changed on the phone — not restored"
msgstr "in der Mitte gelöscht, am Handy geändert — nicht wiederhergestellt"

msgid "the layer “{layer}” does not exist"
msgstr "die Ebene „{layer}“ gibt es nicht"

msgid "the file name does not match the UID"
msgstr "der Dateiname passt nicht zur UID"

msgid "this UID exists more than once in the cloud"
msgstr "diese UID liegt in der Mitte mehrfach"

msgid "this event already exists under another name"
msgstr "diesen Termin gibt es schon unter einem anderen Namen"

msgid "another file already exists at the target"
msgstr "am Ziel liegt schon eine andere Datei"

msgid "this event already exists — changing needs basis_sha (which version was seen); nothing overwritten"
msgstr "diesen Termin gibt es schon — Ändern braucht basis_sha (welche Fassung gesehen wurde), nichts überschrieben"

msgid "changed in the cloud meanwhile, and the version the phone saw is unknown here — nothing overwritten"
msgstr "inzwischen in der Mitte geändert, und die Fassung, die das Handy sah, kenne ich nicht — nichts überschrieben"

msgid "merging gave no readable event — nothing overwritten"
msgstr "Zusammenführen ergab keinen lesbaren Termin — nichts überschrieben"

msgid "conflict — {details}"
msgstr "Widerspruch — {details}"

msgid "another proposal touches the same file"
msgstr "ein anderer Vorschlag trifft dieselbe Datei"

msgid "{event}: changed differently on the phone and in the cloud"
msgstr "{event}: am Handy und in der Mitte verschieden geändert"

msgid "{event}: deleted on one side, changed on the other"
msgstr "{event}: auf der einen Seite gelöscht, auf der anderen geändert"

msgid "Inbox {node}: {path} may not be deleted by it — skipped"
msgstr "Eingang {node}: {path} löschen darf er nicht — übergangen"

msgid "Inbox {node}: event {path} rejected — {reason}; the cloud stays as it is"
msgstr "Eingang {node}: Termin {path} abgelehnt — {reason}; die Mitte bleibt, wie sie ist"

msgid "{path}: differs from the cloud (app newly included) — the cloud wins, the version from here is kept aside"
msgstr "{path}: auf diesem Rechner anders als in der Mitte (App neu dabei) — die Mitte gilt, die Fassung von hier ist aufgehoben"

# ── zentrale_cli: switching the calendar source (befehle.adapter_kalender) ──

msgid "Uploading the calendar to the cloud ({n} files) — this can take a few minutes …"
msgstr "Lade den Kalender in die Cloud ({n} Dateien) — das kann ein paar Minuten dauern …"

msgid "Syncing the calendar with the cloud ({n} files on this device) — this can take a few minutes …"
msgstr "Gleiche den Kalender mit der Cloud ab ({n} Dateien auf diesem Gerät) — das kann ein paar Minuten dauern …"

msgid "  … still syncing ({s} s)"
msgstr "  … läuft noch ({s} s)"

msgid "  done after {s} s."
msgstr "  fertig nach {s} s."

msgid ""
"This device's calendar is not fully in the cloud yet. The next sync finishes it —\n"
"or run 'zentrale adapter calendar zencloud' again now."
msgstr ""
"Der Kalender dieses Geräts ist noch nicht ganz in der Cloud. Der nächste Abgleich macht ihn fertig —\n"
"oder jetzt noch einmal 'zentrale adapter calendar zencloud'."

msgid ""
"Interrupted — the calendar source stays zencloud, nothing was deleted.\n"
"The upload is not finished: run 'zentrale adapter calendar zencloud' again,\n"
"or let the next automatic sync finish it."
msgstr ""
"Abgebrochen — die Kalender-Quelle bleibt zencloud, nichts wurde gelöscht.\n"
"Das Hochladen ist nicht fertig: 'zentrale adapter calendar zencloud' noch einmal,\n"
"oder der nächste automatische Abgleich macht es fertig."

msgid "Calendar source is zencloud — the unfinished first sync of the calendar is now done."
msgstr "Kalender-Quelle ist zencloud — der unterbrochene erste Abgleich des Kalenders ist jetzt fertig."

msgid ""
"Calendar source is zencloud, but the first sync of the calendar is still not done\n"
"({text}) — the next sync tries again. Nothing was deleted."
msgstr ""
"Kalender-Quelle ist zencloud, aber der erste Abgleich des Kalenders ist noch nicht fertig\n"
"({text}) — der nächste Abgleich versucht es wieder. Nichts wurde gelöscht."

# scripts/publish_phone_app.py
msgid "mobile/pubspec.yaml has no 'version:' line."
msgstr "mobile/pubspec.yaml hat keine Zeile 'version:'."

msgid "Cannot read the build's version code; checking the file date instead."
msgstr "Die Versionsnummer des Baus ist nicht lesbar; geprüft wird stattdessen das Dateidatum."

msgid "The APK is signed with the debug key. Phones could never update from it to a release-signed APK. Check ~/.config/zentrale/android/key.properties and build again."
msgstr "Die APK ist mit dem Debug-Schlüssel signiert. Von ihr könnten Handys nie auf eine richtig signierte APK aktualisieren. ~/.config/zentrale/android/key.properties prüfen und neu bauen."

msgid "Could not check the APK signature (keytool missing?)."
msgstr "Die Signatur der APK ließ sich nicht prüfen (keytool fehlt?)."

msgid "Not logged in on this computer. Run 'zentrale login' first."
msgstr "Auf diesem Rechner nicht angemeldet. Erst 'zentrale login'."

msgid "published: nothing yet"
msgstr "veröffentlicht: noch nichts"

msgid "Publish the phone app to the ZENTRALE cloud."
msgstr "Die Handy-App in der ZENTRALE-Cloud veröffentlichen."

msgid "pubspec version vs. the published release"
msgstr "Version in pubspec.yaml gegen die veröffentlichte"

msgid "raise the version code in mobile/pubspec.yaml"
msgstr "die Versionsnummer in mobile/pubspec.yaml erhöhen"

msgid "new version name, e.g. 0.2.0 (default: keep)"
msgstr "neuer Versionsname, z. B. 0.2.0 (sonst bleibt er)"

msgid "do not ask the cloud for its version code"
msgstr "die Cloud nicht nach ihrer Versionsnummer fragen"

msgid "upload the built release APK and its manifest"
msgstr "die gebaute Release-APK und ihre Beschreibung hochladen"

msgid "what is new (shown in the app)"
msgstr "was neu ist (zeigt die App)"

msgid "path of the APK (default: the Flutter release output)"
msgstr "Pfad der APK (sonst die Ausgabe des Flutter-Release-Baus)"

msgid "run 'flutter build apk --release' first (needs RAM)"
msgstr "vorher 'flutter build apk --release' ausführen (braucht RAM)"

msgid "check everything, upload nothing"
msgstr "alles prüfen, nichts hochladen"

msgid "The APK is older than mobile/pubspec.yaml — build it again."
msgstr "Die APK ist älter als mobile/pubspec.yaml — neu bauen."

msgid "pubspec.yaml: {name} (version code {code})"
msgstr "pubspec.yaml: {name} (Versionsnummer {code})"

msgid "mobile/pubspec.yaml is now {name}+{code}. Next: build the release APK, then publish."
msgstr "mobile/pubspec.yaml steht jetzt auf {name}+{code}. Als Nächstes: Release-APK bauen, dann veröffentlichen."

msgid "flutter build failed."
msgstr "flutter build ist fehlgeschlagen."

msgid "Published {name} (version code {code}). Phones see it on their next start."
msgstr "{name} (Versionsnummer {code}) ist veröffentlicht. Die Handys sehen es beim nächsten Start."

msgid "The version code must be between 1 and {max}."
msgstr "Die Versionsnummer muss zwischen 1 und {max} liegen."

msgid "'{name}' is not a valid version name."
msgstr "'{name}' ist kein gültiger Versionsname."

msgid "No APK at {path} — build it first (flutter build apk --release in mobile/)."
msgstr "Keine APK unter {path} — erst bauen (flutter build apk --release in mobile/)."

msgid "published: {name} (version code {code}), {at}"
msgstr "veröffentlicht: {name} (Versionsnummer {code}), {at}"

msgid "Warning: {text}"
msgstr "Warnung: {text}"

msgid "Version code {code} is not higher than the published {remote} — run 'bump' and build again."
msgstr "Versionsnummer {code} ist nicht höher als die veröffentlichte {remote} — 'bump' ausführen und neu bauen."

msgid "Dry run: would publish {name} (version code {code}), {size} bytes, sha256 {sha}."
msgstr "Probelauf: würde {name} (Versionsnummer {code}) veröffentlichen, {size} Bytes, sha256 {sha}."

msgid "The APK was built with version code {built}, pubspec.yaml says {code} — build it again."
msgstr "Die APK wurde mit Versionsnummer {built} gebaut, pubspec.yaml sagt {code} — neu bauen."

msgid "{path}: too large for the cloud ({size} MiB, at most {limit} MiB) — not synced, everything else goes on"
msgstr "{path}: zu groß für die Cloud ({size} MiB, höchstens {limit} MiB) — nicht abgeglichen, alles andere läuft weiter"

msgid "The cloud folder is missing or empty on this device, but the cloud still has its files — nothing was deleted, the folder is not synced until the files are back. To empty it on purpose, delete all but two files, sync, then delete the rest."
msgstr "Der Cloud-Ordner fehlt auf diesem Gerät oder ist leer, die Cloud hat seine Dateien aber noch — nichts gelöscht, der Ordner gleicht erst wieder ab, wenn die Dateien zurück sind. Ihn absichtlich leeren: erst alle bis auf zwei Dateien löschen, abgleichen, dann den Rest."
