#!/usr/bin/env bash
# zentrale-term-theme — koppelt das xfce4-terminal an ZENTRALEs Tag/Nacht-Theme.
#
# Quelle der Wahrheit: ~/.config/zentrale/theme  (ein Wort)
#   auto  → nach Uhrzeit (05–21 Uhr hell, sonst dunkel) — GENAU wie in
#           tui/zentrale_tui.py resolved_theme() und monolith.html computeTheme()
#   day   → fest hell   (manuell in der TUI erzwungen)
#   night → fest dunkel (manuell in der TUI erzwungen)
#
# Wird angestoßen von (a) der TUI bei jedem Moduswechsel (instant) und
# (b) einem systemd-User-Timer jede Minute (fängt die 05/21-Rotation, auch
# wenn die TUI gar nicht läuft). xfce4-terminal übernimmt xfconf-Farben live.
set -u

STATE="${ZENTRALE_THEME_FILE:-$HOME/.config/zentrale/theme}"

mode="auto"
[ -r "$STATE" ] && mode="$(tr -d '[:space:]' < "$STATE")"

case "$mode" in
  day|night) resolved="$mode" ;;
  *)  # auto (Default bei fehlender/kaputter Datei)
      h=$((10#$(date +%H)))          # 10# → keine Oktal-Falle bei 08/09
      if [ "$h" -ge 5 ] && [ "$h" -lt 21 ]; then resolved="day"; else resolved="night"; fi
      ;;
esac

# — Farbpaletten ————————————————————————————————————————————————
# Seit 2026-07-25 NICHT mehr Solarized, sondern dieselben zwei Welten wie in
# nvim (nvim/lua/zentrale_theme/palettes.lua) — damit Terminal und Editor aus
# einem Guss sind statt zwei Farbfamilien nebeneinander:
#   night = cyber : echtes Schwarz + Neon
#   day   = paper : warmes Papier + botanische Tinte
#
# ABSICHTLICHER UNTERSCHIED zur nvim-Fläche: das Terminal ist heller (#f3ecd9,
# Wärme R−B 26) als nvims Blatt (#ece0c0, Wärme 44). Vollflächig las sich das
# tiefe Sepia zu schwer; und der Sprung macht sichtbar, wo der Editor anfängt.
# Gesetzt wird auch die volle 16er-ANSI-Palette (vorher nur bg/fg) — sonst
# blieben ls, Prompt, git & Co. in den alten Solarized-Tönen stehen.
#
# Reihenfolge der Palette: 0-7 normal (schwarz, rot, grün, gelb, blau, magenta,
# cyan, weiß), 8-15 hell. Auf hellem Grund bleiben 7/15 wie bei Solarized Light
# die HELLEN Töne (sonst wäre "weiß" auf Papier unsichtbar).
#
# Und auf Papier sind die "hellen" Farben 9-14 bewusst DUNKLER als 8-13, nicht
# heller: "hell" heißt in der Praxis "hervorgehoben", und auf hellem Grund hebt
# nur mehr Tiefe hervor. Aufgehellt lagen sie bei 3.1–4.2:1 (unlesbar), jetzt
# bei 7:1 gegen die normalen ~5:1 — gemessen, nicht geschätzt.
if [ "$resolved" = "night" ]; then
  BG="#000000"; FG="#ccf7ff"; BOLD="#e8fdff"; CURSOR="#00f0ff"
  SEL_BG="#16333d"; SEL_FG="#ccf7ff"
  PALETTE="#05080a;#ff2f5e;#00ff9c;#ffe93d;#38bdff;#ff2bd6;#00f0ff;#ccf7ff;#577c8a;#ff6b8a;#6bffc0;#fff487;#7fd6ff;#ff74e4;#6ff8ff;#ffffff"
else
  BG="#f3ecd9"; FG="#33291c"; BOLD="#1f1810"; CURSOR="#44661d"
  SEL_BG="#dfe3ba"; SEL_FG="#33291c"
  PALETTE="#33291c;#972920;#44661d;#765c14;#2f5f7d;#8a3357;#3a664b;#e9dfc4;#6e6551;#86241c;#354f16;#59450f;#254b63;#792c4c;#2c4e39;#fbf7ec"
fi

case "${1:-}" in
  --resolve) printf '%s\n' "$resolved"; exit 0 ;;
  --dry-run) printf '%s bg=%s fg=%s\n' "$resolved" "$BG" "$FG"; exit 0 ;;
esac

command -v xfconf-query >/dev/null 2>&1 || exit 0   # kein xfce → still raus

# — Nur bei ÄNDERUNG anfassen ————————————————————————————————————
# Der systemd-Timer ruft uns jede Minute, und bis hierher wurde die komplette
# Palette dann auch jede Minute neu in xfconf geschrieben — obwohl sich fast nie
# etwas ändert. xfce4-terminal färbt bei jedem dieser Schreibvorgänge live um;
# in einem Terminal mit nvim ist das ein sichtbares Zucken, und es kann das
# Terminal dazu bringen, seine Hintergrundfarbe erneut zu melden — worauf nvim
# frueher sein 'background' umstellte (siehe nvim/lua/zentrale_theme/init.lua,
# _disarm_nvim_bg_detect). Wir merken uns deshalb, was zuletzt gesetzt wurde,
# und tun nichts, solange das gleich bleibt. --force übergeht das Gate.
STAMP="${XDG_CACHE_HOME:-$HOME/.cache}/zentrale/term-theme.applied"
if [ "${1:-}" != "--force" ]; then
  [ -r "$STAMP" ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$resolved" ] && exit 0
fi
mkdir -p "$(dirname "$STAMP")" 2>/dev/null

set_prop() { xfconf-query -c xfce4-terminal -p "$1" -s "$2" 2>/dev/null; }
# Bool-Eigenschaften existieren nicht immer schon → notfalls neu anlegen (-n).
set_bool() {
  xfconf-query -c xfce4-terminal -p "$1" -s "$2" 2>/dev/null \
    || xfconf-query -c xfce4-terminal -n -t bool -p "$1" -s "$2" 2>/dev/null
}

set_prop /color-background "$BG"
set_prop /color-foreground "$FG"
set_prop /color-bold       "$BOLD"
set_prop /color-cursor     "$CURSOR"
set_prop /color-palette    "$PALETTE"
set_prop /color-selection            "$SEL_FG"
set_prop /color-selection-background "$SEL_BG"
# Cursor/Fett/Auswahl erzwingen — die Defaults wären teils unsichtbar
# (Cursor auf schwarzem Grund) bzw. würden unsere Werte ignorieren.
set_bool /color-cursor-use-default    false
set_bool /color-bold-use-default      false
set_bool /color-selection-use-default false

# Erst NACH dem erfolgreichen Setzen stempeln — bricht etwas ab, versucht es der
# nächste Timer-Lauf wieder, statt den Zustand für erledigt zu halten.
printf '%s\n' "$resolved" > "$STAMP" 2>/dev/null

exit 0
