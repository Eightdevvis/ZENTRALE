#!/usr/bin/env bash
# zentrale-venv-guard — haengt den Test-Riegel in das geteilte venv.
#
# Alle Arbeitsverzeichnisse (Worktrees wie liegengebliebene Kopien) benutzen
# denselben Interpreter aus dem venv des Haupt-Checkouts. Wer dort testet, kann
# ohne diesen Riegel Sashas echte ~/.config/zentrale/theme umschalten — das war
# der tagelang gesuchte "Theme-Glitch". Warum der Schutz nicht in tests/
# stehen kann, steht ausfuehrlich in scripts/zentrale_testguard.py.
#
# SYMLINK, keine Kopie: so gilt immer der Stand aus main, auch wenn ein alter
# Worktree testet. Gleiches Muster wie beim Theme-Dienst (Commit e684cb1).
# Idempotent — mehrfach aufrufen schadet nicht.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
QUELLE="$ROOT/scripts/zentrale_testguard.py"
VENV="${ZENTRALE_VENV:-$ROOT/venv}"

if [ ! -f "$QUELLE" ]; then
    echo "zentrale-venv-guard: $QUELLE fehlt" >&2
    exit 1
fi

# site-packages selbst suchen statt die Python-Version zu raten.
SITE="$("$VENV/bin/python" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])' 2>/dev/null || true)"
if [ -z "$SITE" ] || [ ! -d "$SITE" ]; then
    echo "zentrale-venv-guard: kein venv unter $VENV (ZENTRALE_VENV setzt den Pfad)" >&2
    exit 1
fi

MODUL="$SITE/zentrale_testguard.py"
PTH="$SITE/zentrale_testguard.pth"

# NICHT sitecustomize.py: Debian legt ein eigenes unter /usr/lib/python3.12 ab,
# und die stdlib steht im sys.path vor site-packages — unsere Datei wuerde
# lautlos nie geladen. Der Grund steht ausfuehrlich in scripts/zentrale_testguard.py.
if [ -e "$MODUL" ] && [ ! -L "$MODUL" ]; then
    echo "zentrale-venv-guard: $MODUL existiert und ist kein Symlink — bitte von Hand ansehen" >&2
    exit 1
fi

ln -sfn "$QUELLE" "$MODUL"
printf 'import zentrale_testguard\n' > "$PTH"

# Aufraeumen: der erste Versuch hing als sitecustomize.py hier (wirkungslos).
ALT="$SITE/sitecustomize.py"
if [ -L "$ALT" ] && [ "$(readlink "$ALT")" = "$QUELLE" ]; then
    rm -f "$ALT"
    echo "zentrale-venv-guard: alten (wirkungslosen) sitecustomize-Symlink entfernt"
fi

echo "zentrale-venv-guard: $MODUL -> $QUELLE"
echo "zentrale-venv-guard: $PTH (import zentrale_testguard)"
