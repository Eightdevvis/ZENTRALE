#!/usr/bin/env bash
# zentrale-desktop-theme — koppelt den XFCE-Desktop an ZENTRALEs Tag/Nacht-Theme.
#
# Quelle der Wahrheit ist DIESELBE Datei wie bei Terminal, nvim und Browser:
#   ~/.config/zentrale/theme  (auto | day | night), auto → 05–21 Uhr hell.
#
# WARUM auch der Desktop: Brave steht auf "Use GTK" und holt sich seine
# Oberflächenfarben damit aus dem GTK-Theme. Solange das fest dunkel ist, sieht
# man vom Portal-Signal fast nichts — es bewegt dann nur noch die Seiten. Der
# Desktop ist also nicht Beiwerk, sondern der sichtbare Teil der Browser-Kopplung.
#
# ACHTUNG (2026-08-03): Das galt nur, solange Brave NICHT als Flatpak lief. Als
# Flatpak sieht er weder die Theme-Dateien noch den Namen aus xfconf — Details
# und Abhilfe stehen im Abschnitt "Flatpaks nachziehen" ganz unten.
#
# THEMEN-WAHL — angelehnt an die nvim-Paletten (cyber/paper), aus Mints Bestand:
#   night → Mint-L-Darker-Aqua  (dunkelste Variante, kühl-cyaner Akzent #6cabcd
#                                → nächstverwandt zu cyber-Neon; Mint hat kein Neon)
#   day   → Mint-L-Sand         (warmer Ocker-Akzent #c8ac69 → Sepia/Papier)
# Rahmen (xfwm4) laufen mit; "Darker" bringt kein xfwm4 mit, nachts nimmt der
# Rahmen deshalb Mint-L-Dark-Aqua.
# Alles über Env überstimmbar, ohne dieses Skript anzufassen:
#   ZENTRALE_GTK_DAY / ZENTRALE_GTK_NIGHT / ZENTRALE_WM_DAY / ZENTRALE_WM_NIGHT
#
# ICONS laufen seit 2026-07-25 mit: ZENTRALE-Cyber / ZENTRALE-Paper, gebaut von
# scripts/build_icon_themes.py — Papirus geerbt, nur die Ordner in Akzentfarbe
# (cyan nachts, warmes Braun tagsüber). Vorher stand hier HighContrast.
#
# UMKEHRBAR: beim ERSTEN Lauf werden die vorgefundenen Werte nach
# ~/.config/zentrale/desktop-theme.bak gesichert; `--restore` setzt sie zurück.
set -u

STATE="${ZENTRALE_THEME_FILE:-$HOME/.config/zentrale/theme}"
BAK="${ZENTRALE_DESKTOP_BAK:-$HOME/.config/zentrale/desktop-theme.bak}"

GTK_DAY="${ZENTRALE_GTK_DAY:-Mint-L-Sand}"
GTK_NIGHT="${ZENTRALE_GTK_NIGHT:-Mint-L-Darker-Aqua}"
WM_DAY="${ZENTRALE_WM_DAY:-Mint-L-Sand}"
WM_NIGHT="${ZENTRALE_WM_NIGHT:-Mint-L-Dark-Aqua}"
# Icons: die abgeleiteten Papirus-Sets (scripts/build_icon_themes.py) — cyane
# Ordner nachts, warme tagsüber. Fehlen sie, nehmen wir Papirus direkt, damit
# der Wechsel trotzdem hell/dunkel folgt statt gar nicht.
ICON_DAY="${ZENTRALE_ICON_DAY:-ZENTRALE-Paper}"
ICON_NIGHT="${ZENTRALE_ICON_NIGHT:-ZENTRALE-Cyber}"
ICON_DAY_FALLBACK="Papirus-Light"
ICON_NIGHT_FALLBACK="Papirus-Dark"

NOW="${ZENTRALE_THEME_NOW:-$HOME/.config/zentrale/theme.now}"

# ── Die effektive Farbe kommt vom Dienst, wir rechnen NICHTS ──────────────
# Aufgelöst wird an genau einer Stelle im Projekt: scripts/zentrale-themed
# schreibt day|night nach theme.now. Vorher rechnete jeder Applier die
# 05/21-Regel selbst — acht Kopien derselben zwei Zahlen, jede mit eigenem
# Timing, und genau daran lag die Serie von Theme-Glitches.
resolve() {
  local r
  r="$(tr -d '[:space:]' < "$NOW" 2>/dev/null)"
  if [ "$r" != "day" ] && [ "$r" != "night" ]; then
    # Datei fehlt (Dienst lief noch nie) → ihn EINMAL rechnen lassen, statt
    # hier eine zweite Auflösung aufzumachen.
    zentrale-themed --once >/dev/null 2>&1 || true
    r="$(tr -d '[:space:]' < "$NOW" 2>/dev/null)"
    [ "$r" = "day" ] || [ "$r" = "night" ] || r="day"
  fi
  printf '%s
' "$r"
}

RESOLVED="$(resolve)"
if [ "$RESOLVED" = "night" ]; then
  GTK="$GTK_NIGHT"; WM="$WM_NIGHT"; ICON="$ICON_NIGHT"; ICON_FB="$ICON_NIGHT_FALLBACK"
else
  GTK="$GTK_DAY";   WM="$WM_DAY";   ICON="$ICON_DAY";   ICON_FB="$ICON_DAY_FALLBACK"
fi

# Icon-Theme da? Sonst auf Papirus zurückfallen (siehe oben).
icon_installed() { [ -d "/usr/share/icons/$1" ] || [ -d "$HOME/.local/share/icons/$1" ]; }
icon_installed "$ICON" || { icon_installed "$ICON_FB" && ICON="$ICON_FB"; }

get() { xfconf-query -c "$1" -p "$2" 2>/dev/null; }
# Nur schreiben, wenn sich der Wert wirklich ändert. Der systemd-Timer ruft uns
# jede Minute; vorher wurde GTK-, Fenster- UND Icon-Theme dabei jedes Mal neu
# gesetzt, obwohl fast immer schon der richtige Wert stand. Jede GTK-App lädt
# daraufhin ihre Icons neu — der Desktop ruckelt sichtbar, und Programme, die
# auf Theme-Wechsel reagieren, tun das im Minutentakt völlig grundlos.
set_prop() {
  [ "$(get "$1" "$2")" = "$3" ] && return 0
  xfconf-query -c "$1" -p "$2" -s "$3" 2>/dev/null
}

# ── Kein Schreiben in eine LAUFENDE Sitzung aus einem Testlauf ───────────
# Applier schreiben nicht in Dateien, sondern in Sitzungs-Dienste (xfconf,
# gsettings). Die haengen NICHT an HOME — jede Isolation ueber HOME oder
# Env-Variablen greift bei ihnen prinzipiell nicht, sie treffen IMMER die
# echte Sitzung des angemeldeten Menschen. Ein Testlauf hat dort nichts
# verloren: am 2026-08-18 stand Sashas Desktop wiederholt auf der
# Nacht-Kombination, waehrend theme und theme.now unveraendert "day" sagten
# — erkennbar am Icon-Fallback (Papirus statt ZENTRALE-*), weil der Applier
# mit einem Wegwerf-HOME lief. Im Protokoll stand nichts, weil dabei gar
# keine Theme-Datei angefasst wurde.
#
# Deshalb: im Testlauf verhaelt sich der Applier wie --dry-run. Ausgabe ja
# (Tests pruefen sie), Sitzung unberuehrt. Reine Auskunfts-Aufrufe bleiben,
# was sie sind. Erklaerung: memory/system/dashboard.md.
case "${1:-}" in
  --dry-run|--resolve|--help|-h) : ;;
  *) if [ -n "${ZENTRALE_TESTLAUF:-}" ] || [ -n "${PYTEST_VERSION:-}" ] \
       || [ -n "${PYTEST_CURRENT_TEST:-}" ]; then
       set -- --dry-run
     fi ;;
esac

case "${1:-}" in
  --resolve) printf '%s\n' "$RESOLVED"; exit 0 ;;
  --dry-run) printf '%s gtk=%s wm=%s icons=%s\n' "$RESOLVED" "$GTK" "$WM" "$ICON"; exit 0 ;;
  --status)
    printf 'theme-datei : %s\n' "$STATE"
    printf 'aufgeloest  : %s -> gtk=%s wm=%s icons=%s\n' "$RESOLVED" "$GTK" "$WM" "$ICON"
    printf 'jetzt aktiv : gtk=%s wm=%s icons=%s\n' \
      "$(get xsettings /Net/ThemeName)" "$(get xfwm4 /general/theme)" \
      "$(get xsettings /Net/IconThemeName)"
    [ -f "$BAK" ] && { printf 'sicherung   : %s\n' "$BAK"; cat "$BAK"; } \
                  || printf 'sicherung   : (noch keine)\n'
    exit 0 ;;
  --restore)
    [ -f "$BAK" ] || { echo "keine Sicherung unter $BAK" >&2; exit 1; }
    # shellcheck disable=SC1090
    . "$BAK"
    [ -n "${PREV_GTK:-}" ] && set_prop xsettings /Net/ThemeName "$PREV_GTK"
    [ -n "${PREV_WM:-}"  ] && set_prop xfwm4     /general/theme "$PREV_WM"
    [ -n "${PREV_ICON:-}" ] && set_prop xsettings /Net/IconThemeName "$PREV_ICON"
    echo "zurückgesetzt: gtk=${PREV_GTK:-?} wm=${PREV_WM:-?} icons=${PREV_ICON:-?}"
    exit 0 ;;
esac

command -v xfconf-query >/dev/null 2>&1 || exit 0   # kein xfce → still raus

# Einmalige Sicherung des Vorzustands (nur wenn noch keine da ist).
if [ ! -f "$BAK" ]; then
  mkdir -p "$(dirname "$BAK")" 2>/dev/null
  { printf 'PREV_GTK=%s\n'  "$(get xsettings /Net/ThemeName)"
    printf 'PREV_WM=%s\n'   "$(get xfwm4 /general/theme)"
    printf 'PREV_ICON=%s\n' "$(get xsettings /Net/IconThemeName)"; } > "$BAK" 2>/dev/null
fi

# Nur setzen, wenn ein Theme wirklich installiert ist — sonst stünde der Desktop
# auf einem Namen, den es nicht gibt (GTK fällt dann auf Adwaita zurück).
[ -d "/usr/share/themes/$GTK" ] || [ -d "$HOME/.themes/$GTK" ] \
  && set_prop xsettings /Net/ThemeName "$GTK"
[ -d "/usr/share/themes/$WM/xfwm4" ] || [ -d "$HOME/.themes/$WM/xfwm4" ] \
  && set_prop xfwm4 /general/theme "$WM"
icon_installed "$ICON" && set_prop xsettings /Net/IconThemeName "$ICON"

# ── Flatpaks nachziehen (Brave!) ──────────────────────────────────────────────
# xfconf/XSettings erreicht nur Programme, die auf dem HOST laufen. Brave ist
# hier ein Flatpak und sieht davon zweierlei nicht:
#   1. den NAMEN   – ein Flatpak liest ihn über GSettings, nicht über xfconf.
#   2. die DATEIEN – im Sandkasten liegt unter /usr/share/themes nur "Default"
#      und "Emacs". /usr ist von Flatpak reserviert und lässt sich auch per
#      `flatpak override --filesystem=/usr/share/themes` NICHT durchreichen
#      ("Path /usr is reserved by Flatpak"). Der einzige Weg führt übers
#      Heimverzeichnis.
# Deshalb hat der Kommentar oben ("Brave steht auf Use GTK und holt sich seine
# Farben aus dem GTK-Theme") bis 2026-08-03 nicht gestimmt: Das Portal-Signal
# kam an, das Theme selbst nie.
#
# EINMALIG nötig, steht nicht in diesem Skript, weil es Sandkasten-Rechte sind:
#   flatpak override --user com.brave.Browser --filesystem=xdg-data/themes:ro
# UND im Browser brave://settings/appearance auf GTK stellen – steht dort das
# klassische Theme, ignoriert Brave alles hier
# (Pref extensions.theme.system_theme: 0 = klassisch, 1 = GTK).

# 1. Dateien: aktives Theme ins Heimverzeichnis spiegeln, falls noch nicht da.
#    Nur bei Bedarf – kostet einmalig ~3–4 MB je Theme, danach nichts mehr.
USER_THEMES="$HOME/.local/share/themes"
if [ -d "/usr/share/themes/$GTK" ] && [ ! -d "$USER_THEMES/$GTK" ]; then
  mkdir -p "$USER_THEMES" 2>/dev/null
  cp -a "/usr/share/themes/$GTK" "$USER_THEMES/" 2>/dev/null
fi

# 2. Name: dieselben Werte nach GSettings spiegeln, damit das Portal sie meldet.
#    color-scheme bleibt außen vor – das setzt zentrale-browser-theme.
#    Auch hier nur bei Abweichung: jedes gsettings-set feuert ein Portal-Signal,
#    auf das Flatpaks (Brave) mit einem Theme-Neuaufbau antworten.
if command -v gsettings >/dev/null 2>&1; then
  gset() {   # $1 key, $2 wert — gsettings get liefert den Wert in Hochkommas
    [ "$(gsettings get org.gnome.desktop.interface "$1" 2>/dev/null)" = "'$2'" ] \
      && return 0
    gsettings set org.gnome.desktop.interface "$1" "$2" 2>/dev/null
  }
  gset gtk-theme  "$GTK"
  gset icon-theme "$ICON"
fi

exit 0
