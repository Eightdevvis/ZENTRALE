    "arm_r_unter":  {"pivot": [340, 340], "eltern": "arm_r_ober",  "_": "Ellbogen rechts"},

    "bein_l_ober":  {"pivot": [226, 448], "eltern": "torso",       "_": "Huefte links"},
    "bein_l_unter": {"pivot": [226, 532], "eltern": "bein_l_ober", "_": "Knie links"},
    "bein_r_ober":  {"pivot": [286, 448], "eltern": "torso",       "_": "Huefte rechts"},
    "bein_r_unter": {"pivot": [286, 532], "eltern": "bein_r_ober", "_": "Knie rechts"},

    "auge_l":       {"pivot": [225, 142], "eltern": "kopf",        "_": "Auge links, Varianten in gesicht/"},
    "auge_r":       {"pivot": [287, 142], "eltern": "kopf",        "_": "Auge rechts"},
    "mund":         {"pivot": [256, 184], "eltern": "kopf",        "_": "Mund, Varianten in gesicht/"}
