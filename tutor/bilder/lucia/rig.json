{
  "_kommentar": [
    "Bauplan der Puppe. Sasha malt die Bilder, diese Datei sagt dem Code,",
    "wo jedes Teil sich dreht und in welcher Reihenfolge gezeichnet wird.",
    "Alle Koordinaten in Leinwand-Pixeln (siehe leinwand). Siehe LIES_MICH.md."
  ],

  "leinwand": {
    "breite": 512,
    "hoehe": 640,
    "boden_y": 604,
