  },

  "reihenfolge": [
    "bein_l_ober", "bein_l_unter",
    "bein_r_ober", "bein_r_unter",
    "arm_l_ober", "arm_l_unter",
    "torso",
    "kopf", "auge_l", "auge_r", "mund",
    "arm_r_ober", "arm_r_unter"
  ],

  "slots": {
    "torso":        {"pivot": [256, 472], "eltern": null,          "_": "Drehpunkt = Huefte"},
