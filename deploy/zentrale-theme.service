[Unit]
Description=ZENTRALE: Umgebung an Tag/Nacht-Theme koppeln (Terminal, Browser, Desktop, bat)
After=graphical-session.target

[Service]
Type=oneshot
# Ein Aufruf, mehrere Ziele. nvim braucht KEINEN Push: es beobachtet die
# Theme-Datei selbst (fs_event + eigener Tick), siehe nvim/lua/zentrale_theme.
# Jeder Applier hat ein eigenes „nur bei Änderung"-Gate — der Minutentakt
# schreibt also nichts, solange sich der Modus nicht dreht.
ExecStart=%h/.local/bin/zentrale-term-theme
ExecStart=%h/.local/bin/zentrale-browser-theme
ExecStart=%h/.local/bin/zentrale-desktop-theme
# bat liest seine Config bei jedem Aufruf neu — der Applier schreibt nur die
# --theme-Zeile um, der nächste `batcat` hat die neue Farbe. Führendes `-`:
# bat ist optional, ohne installiertes bat gibt es den Symlink nicht, und ein
# fehlendes Kür-Ziel darf den ganzen oneshot-Service nicht rot färben.
ExecStart=-%h/.local/bin/zentrale-bat-theme
